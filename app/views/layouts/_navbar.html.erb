<nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom sticky-top">
  <div class="container">
    <%= link_to "Football Masters", root_path, class: "navbar-brand fw-bold" %>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#mainNavbar"
      aria-controls="mainNavbar"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNavbar">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <% if admin_access? %>
          <li class="nav-item dropdown">
            <a
              class="nav-link dropdown-toggle"
              href="#"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              Админка
            </a>

            <ul class="dropdown-menu">
              <li><%= link_to "Юзеры", admin_users_path, class: "dropdown-item" %></li>
              <li><hr class="dropdown-divider"></li>
              <li><%= link_to "Страны", admin_nations_path, class: "dropdown-item" %></li>
              <li><hr class="dropdown-divider"></li>
              <li><%= link_to "Матчи", admin_matches_path, class: "dropdown-item" %></li>
              <li><%= link_to "Ждут обработки", pending_admin_matches_path, class: "dropdown-item" %></li>
              <% if policy([:admin, Visit]).index? %>
                <li><hr class="dropdown-divider"></li>
                <li><%= link_to "Посещения", admin_visits_path, class: "dropdown-item" %></li>
              <% end %>
            </ul>
          </li>
        <% end %>

        <li class="nav-item">
          <%= link_to "Очки", users_path, class: "nav-link" %>
        </li>

        <li class="nav-item">
          <%= link_to "Сборные", nations_path, class: "nav-link" %>
        </li>

        <li class="nav-item">
          <%= link_to "Матчи", matches_path, class: "nav-link" %>
        </li>

        <li class="nav-item">
          <%= link_to "v #{Rails.configuration.x.app.version}",
              "#", class: "nav-link disabled", aria: { disabled: "true" } %>
        </li>
      </ul>

      <ul class="navbar-nav mb-2 mb-lg-0">
        <li class="nav-item">
          <%= link_to "Правила", rules_path, class: "nav-link" %>
        </li>
        <% if user_signed_in? %>
          <li class="nav-item dropdown">
            <a
              class="nav-link dropdown-toggle d-flex align-items-center gap-2"
              href="#"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <%= user_avatar(current_user, size: "1.5rem") %>
              <%= current_user.name %>
            </a>

            <ul class="dropdown-menu dropdown-menu-end">
              <li>
                <span class="dropdown-item-text text-muted small">
                  Роль: <%= current_user.role %>
                </span>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= button_to "Выйти", logout_path, method: :delete,
                    class: "dropdown-item" %>
              </li>
            </ul>
          </li>
        <% else %>
          <li class="nav-item">
            <span class="nav-link disabled" aria-disabled="true">Гость</span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
