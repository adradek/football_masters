<% content_for :title, "Матчи" %>

<div class="container py-4" style="margin-top: 4rem;">
  <div class="section-heading mb-4">
    <div><h1 class="h3 mb-0 fw-bold">Матчи</h1></div>
  </div>

  <% if @matches.any? %>
    <div class="match-list">
      <% @matches.each do |match| %>
        <article class="match-card<%= " match-card--pending" if match.need_processing? %>">
          <header class="match-card-top">
            <span class="match-card-stage">
              <%= match_stage(match) %>
            </span>
            <time class="match-card-date">
              <%= match.played_at&.strftime("%d.%m.%Y · %H:%M") %>
            </time>
          </header>

          <div class="match-card-body">
            <div class="match-team match-team--home">
              <% if match.home %>
                <span class="match-team-name"><%= match.home&.name %></span>
                <span class="match-flag"><%= match.home.flag_emoji %></span>
              <% else %>
                <span class="match-team-name">—</span>
              <% end %>
            </div>

            <div class="match-score">
              <% if match.score.present? %>
                <span class="match-score-value"><%= match.score %></span>
                <% if match.score_penalty.present? %>
                  <span class="match-score-note">пен. <%= match.score_penalty %></span>
                <% elsif match.score_extra.present? %>
                  <span class="match-score-note">д.в. <%= match.score_extra %></span>
                <% end %>
              <% else %>
                <span class="match-score-value match-score-value--vs">:</span>
              <% end %>
            </div>

            <div class="match-team match-team--away">
              <% if match.away %>
                <span class="match-flag"><%= match.away.flag_emoji %></span>
                <span class="match-team-name"><%= match.away.name %></span>
              <% else %>
                <span class="match-team-name">—</span>
              <% end %>
            </div>
          </div>

          <footer class="match-card-bottom">
            <% if match.completed? %>
              <span class="badge text-bg-success">Обработан</span>
            <% elsif match.need_processing? %>
              <span class="badge text-bg-warning">Ждёт обработки</span>
            <% else %>
              <span class="badge text-bg-secondary"><%= match.state.humanize %></span>
            <% end %>

            <% if superadmin? && match.need_processing? %>
              <%= link_to "Обработать →", "#", class: "btn btn-sm btn-outline-warning" %>
            <% end %>
          </footer>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted">Матчей пока нет.</p>
  <% end %>
</div>
