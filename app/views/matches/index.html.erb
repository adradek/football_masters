<% content_for :title, "Матчи" %>

<div class="container py-4" style="margin-top: 4rem;">
  <div class="section-heading mb-4">
    <div><h3 class="h3 mb-0 fw-bold">Ближайшие матчи</h3></div>
  </div>
  <% if @upcoming_matches.any? %>
    <div class="match-list">
      <%= render partial: "match", collection: @upcoming_matches %>
    </div>
  <% else %>
    <p class="text-muted">Ближайших матчей в базе нет 🤷‍♂️</p>
  <% end %>
</div>

<% if @need_processing.any? %>
  <div class="container py-4" style="margin-top: 4rem;">
    <div class="section-heading mb-4">
      <div><h3 class="h3 mb-0 fw-bold">Требуют обработки</h3></div>
    </div>
    <div class="match-list">
      <%= render partial: "match", collection: @need_processing %>
    </div>
  </div>
<% end %>

<div class="container py-4" style="margin-top: 4rem;">
  <% if @history.any? %>
    <div class="section-heading mb-4">
      <div><h3 class="h3 mb-0 fw-bold">Результаты</h3></div>
    </div>
    <div class="match-list">
      <%= render partial: "match", collection: @history %>
    </div>
  <% end %>
</div>
