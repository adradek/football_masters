<div class="container">
  <h1>World Cup 2026</h1>

  <% @groups.each do |group| %>
    <h2><%= group.name %></h2>

    <ul>
      <% group.nations.each do |nation| %>
        <li>
          <div class="group-nation">
            <span class="group-nation-flag">
              <%= nation.flag_emoji %>
            </span>
            <%= nation.name %>
          </div>
        </li>
      <% end %>

    </ul>
  <% end %>
</div>
