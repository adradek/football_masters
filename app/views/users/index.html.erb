<% content_for :title, "Игроки" %>

<% content_for :head do %>
  <style>
    .players-table tbody tr.is-current-user {
      background-color: var(--bs-success-bg-subtle);
      box-shadow: inset 4px 0 0 var(--bs-success);
    }
    .players-table tbody tr.is-current-user td {
      background-color: transparent;
    }
    .players-table tbody tr.secondary-squad {
      background-color: #cccccc;
      box-shadow: inset 4px 0 0 #cccccc;
    }
    .players-table tbody tr.secondary-squad td {
      background-color: transparent;
    }
    .player-color-dot {
      width: 1.1rem;
      height: 1.1rem;
      flex: 0 0 auto;
    }
    .nation-chip {
      font-weight: 500;
    }
  </style>
<% end %>

<div class="container py-4" style="margin-top: 4rem;">
  <%= render "results" %>
</div>
