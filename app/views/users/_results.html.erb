<div id="results">
  <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
    <i class="bi bi-megaphone-fill fs-5"></i>
    <span>
      <span class="fw-semibold">До воскресенья данные обновляться не будут. А может и будут</span>
    </span>
  </div>

  <div class="d-flex align-items-center gap-2 mb-3 text-muted">
    <i class="bi bi-clock-history"></i>
    <span>
      Данные актуальны на
      <span class="fw-semibold text-body"><%= @actual_at.strftime("%d.%m.%Y %H:%M") %></span>
    </span>

    <% if user_signed_in? && current_user.knows_about_shadows? %>
      <%= button_to toggle_shadows_users_path,
            method: :patch,
            form_class: "ms-auto",
            class: "btn btn-sm d-inline-flex align-items-center gap-1 #{current_user.show_shadows? ? "btn-secondary" : "btn-outline-secondary"}",
            title: current_user.show_shadows? ? "Скрыть теневые составы" : "Показать теневые составы" do %>
        <i class="bi <%= current_user.show_shadows? ? "bi-eye-fill" : "bi-eye-slash" %>"></i>
        Теневые составы
      <% end %>
    <% end %>
  </div>

  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0 players-table">
        <thead class="table-light">
          <tr>
            <th scope="col" class="text-muted small text-uppercase">#</th>
            <% if user_signed_in? && current_user.money_ball? %>
              <th scope="col" class="text-muted small text-uppercase">🏆</th>
            <% end %>
            <th scope="col" class="text-muted small text-uppercase">Игрок</th>
            <th scope="col" class="text-muted small text-uppercase">Команды</th>
            <th scope="col" class="text-muted small text-uppercase">Встречи (1/16)</th>
            <th scope="col" class="text-muted small text-uppercase text-end">Очки</th>
          </tr>
        </thead>
        <tbody>
          <% @results.each do |record| %>
            <tr class="<%= squad_html_class(record) %>">
              <td><%= record.place %></td>
              <% if user_signed_in? && current_user.money_ball? %>
                <td title="отдельный конкурс"><%= "💰" if record.user.money_ball? && record.main? %></td>
              <% end %>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <%= user_avatar(record.user) %>
                  <div>
                    <div class="fw-semibold d-flex align-items-center gap-2">
                      <%= record.name %>
                    </div>
                  </div>
                </div>
              </td>
              <td>
                <% if record.nations.any? %>
                  <div class="d-flex flex-wrap gap-1">
                    <% record.nations.sort_by { -it.price }.each do |nation| %>
                      <%= link_to nation_path(nation), class: "text-decoration-none text-body" do %>
                        <span class="<%= nation_flag_classes(nation, "ms-3", "fs-4", "lh-1") %>"
                          title="<%= "#{ nation.name } (#{ nation.points }/#{ nation.price })" %>"
                        >
                          <%= nation.flag_emoji %>
                        </span>
                      <% end %>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-muted">Сквад не выбран</span>
                <% end %>
              </td>
              <td>
                <%#= Bonus.where(nation_id: record.nations.map(&:id)).where.not(reason: "promotion").count %>
                <%= record.round_actual_matches %>
                из
                <%= record.round_expected_matches(former_stage: "group_round") %>
                <span class="arrow">→</span>
                <%= record.promoted_nations_number %>
              </td>
              <td class="text-end">
                <span class="fw-semibold"><%= record.points %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
