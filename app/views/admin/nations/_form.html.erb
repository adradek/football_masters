<%= form_with model: [:admin, @nation] do |f| %>
  <% if @nation.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h2 class="h6 alert-heading">
        <%= "Ошибок при сохранении: #{@nation.errors.size}" %>
      </h2>
      <ul class="mb-0">
        <% @nation.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, "Название", class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :flag_emoji, "Флаг (эмодзи)", class: "form-label" %>
    <%= f.text_field :flag_emoji, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :normalized_name, "Нормализованное имя", class: "form-label" %>
    <%= f.text_field :normalized_name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :fifa_place, "Место в рейтинге FIFA", class: "form-label" %>
    <%= f.number_field :fifa_place, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :fifa_rank, "Очки рейтинга FIFA", class: "form-label" %>
    <%= f.number_field :fifa_rank, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :points, "Очки", class: "form-label" %>
    <%= f.number_field :points, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :price, "Цена", class: "form-label" %>
    <%= f.number_field :price, class: "form-control" %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :leaved, class: "form-check-input" %>
    <%= f.label :leaved, "Выбыла", class: "form-check-label" %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit submit_label, class: "btn btn-primary" %>
    <%= link_to "Отмена", admin_nations_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
