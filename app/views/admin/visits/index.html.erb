<% content_for :title, "Посещения" %>

<div class="container py-4" style="margin-top: 4rem;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Посещения</h1>
    <span class="text-muted">Всего: <%= @visits.total %></span>
  </div>

  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col">Юзер</th>
            <th scope="col">24h</th>
            <th scope="col">Последнее</th>
            <th scope="col" class="text-end">Посещений</th>
          </tr>
        </thead>
        <tbody>
          <% @visits.visitors.each do |visitor| %>
            <tr class="<%= visitor.user ? (visitor.last_day_visits > 0 ? "table-success" : "") : "table-light" %>">
              <td class="<%= visitor.user ? "" : "text-muted" %>">
                <% if visitor.user %>
                  <%= user_avatar(visitor.user, size: "1.5rem") %>
                <% end %>
                <%= visitor.name %>
              </td>
              <td><%= visitor.last_day_visits %></td>
              <td><%= visitor.last_visit&.strftime("%d.%m.%Y %H:%M") %></td>
              <td class="text-end"><%= visitor.total_visits %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
