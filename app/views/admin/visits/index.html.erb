<% content_for :title, "Посещения" %>

<div class="container py-4" style="margin-top: 4rem;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Посещения</h1>
    <span class="text-muted">Всего: <%= @total %></span>
  </div>

  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col">Юзер</th>
            <th scope="col" class="text-end">Посещений</th>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |user, count| %>
            <tr>
              <td>
                <% if user %>
                  <%= user_avatar(user, size: "1.5rem") %>
                  <%= user.name %>
                <% else %>
                  <span class="text-muted">(удалённый юзер)</span>
                <% end %>
              </td>
              <td class="text-end"><%= count %></td>
            </tr>
          <% end %>

          <tr class="table-light">
            <td><span class="text-muted">Гость (без авторизации)</span></td>
            <td class="text-end"><%= @guest_count %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
