<%= form_with model: [:admin, @match, @bonus] do |f| %>
  <% if @bonus.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h2 class="h6 alert-heading">
        <%= pluralize(@bonus.errors.count, "ошибка", "ошибки", "ошибок") %> при сохранении:
      </h2>
      <ul class="mb-0">
        <% @bonus.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% nations = [@match.home, @match.away].compact %>
  <% nations = Nation.order(:name) if nations.empty? %>
  <% reasons = Bonus.reason_labels.map { |key, label| [label, key] } %>

  <div class="row g-3">
    <div class="col-12">
      <%= f.label :nation_id, "Команда", class: "form-label" %>
      <%= f.collection_select :nation_id, nations, :id, :name_with_flag,
            { prompt: "Выберите команду" }, class: "form-select" %>
    </div>

    <div class="col-12 col-md-6">
      <%= f.label :reason, "Причина", class: "form-label" %>
      <%= f.select :reason, reasons, {}, class: "form-select" %>
    </div>

    <div class="col-12 col-md-6">
      <%= f.label :value, "Очки", class: "form-label" %>
      <%= f.number_field :value, class: "form-control" %>
    </div>

    <div class="col-12">
      <%= f.label :description, "Описание", class: "form-label" %>
      <%= f.text_field :description, class: "form-control", placeholder: "Победа над ... (2:1)" %>
    </div>
  </div>

  <div class="d-flex gap-2 mt-4">
    <%= f.submit "Сохранить бонус", class: "btn btn-primary" %>
    <%= link_to "Отмена", admin_match_bonuses_path(@match), class: "btn btn-outline-secondary" %>
  </div>
<% end %>
