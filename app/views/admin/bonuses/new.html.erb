<% content_for :title, "Обработка матча" %>

<div class="container py-4" style="margin-top: 4rem;">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Обработка матча</h1>
        <%= link_to "К матчам", admin_matches_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>

      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="badge text-bg-secondary"><%= @match.stage.humanize %></span>
            <span class="text-muted small">
              <%= @match.played_at ? l(@match.played_at, format: :short) : "—" %>
            </span>
          </div>

          <div class="d-flex justify-content-between align-items-center fs-5 mb-3">
            <span class="fw-semibold text-end">
              <%= @match.home&.name_with_flag || "— хозяева —" %>
            </span>
            <span class="badge text-bg-light border mx-2"><%= @match.score.presence || "—" %></span>
            <span class="fw-semibold">
              <%= @match.away&.name_with_flag || "— гости —" %>
            </span>
          </div>

          <%= form_with url: admin_match_bonus_checks_path(@match), method: :post do %>
            <%= submit_tag "Проверить", class: "btn btn-outline-warning" %>
          <% end %>

          <div id="bonus_check_result" class="mt-4"></div>
        </div>
      </div>
    </div>
  </div>
</div>
