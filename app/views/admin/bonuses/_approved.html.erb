<div class="alert alert-success" role="alert">
  Матч корректен — можно начислять бонусы.
</div>

<div class="list-group mb-3">
  <% bonuses.each_value do |award| %>
    <div class="list-group-item d-flex justify-content-between align-items-center">
      <span>
        <span class="fw-semibold"><%= award[:nation].name_with_flag %></span>
        <span class="text-muted small d-block"><%= award[:description] %></span>
      </span>
      <span class="badge text-bg-primary rounded-pill fs-6">+<%= award[:value] %></span>
    </div>
  <% end %>
</div>

<%= form_with url: admin_match_bonuses_path(match), method: :post do %>
  <%= submit_tag "Начислить бонусы", class: "btn btn-success" %>
<% end %>
