<% content_for :title, "Пользователи" %>

<div class="container py-4" style="margin-top: 4rem;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Пользователи</h1>
    <% if policy([:admin, User]).create? %>
      <%= link_to "Добавить юзера", new_admin_user_path, class: "btn btn-outline-success" %>
    <% end %>
  </div>

  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col">Имя</th>
            <th scope="col">Роль</th>
            <th scope="col">Цвет</th>
            <th scope="col">Основной выбор</th>
            <% if policy([:admin, User]).edit? %>
              <th scope="col">Ссылка</th>
            <% end %>
            <th scope="col">Кнопки</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <% main_squad = user.squads.find(&:main?) %>
            <tr>
              <td><%= user.name %></td>
              <td><span class="badge text-bg-secondary"><%= user.role %></span></td>
              <td>
                <% if user.color.present? %>
                  <span class="d-inline-flex align-items-center gap-2">
                    <span class="d-inline-block rounded border"
                          style="width: 1.25rem; height: 1.25rem; background-color: <%= user.color %>;"></span>
                    <code><%= user.color %></code>
                  </span>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td>
                <% if main_squad && main_squad.nations.any? %>
                  <div class="d-flex flex-wrap gap-1">
                    <% main_squad.nations.sort_by { -it.price }.each do |nation| %>
                      <span class="badge text-bg-light border">
                        <%= nation.flag_emoji %> <%= nation.name %> (<%= nation.price %>)
                      </span>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <% if policy([:admin, user]).edit? %>
                <td>
                  <%= link_to "link", login_url(user.secret) %>
                </td>
              <% end %>
              <td>
                <div class="d-flex gap-1">
                  <%= link_to "squads", admin_user_squads_path(user), class: "btn btn-sm btn-outline-primary" %>
                  <% if policy([:admin, user]).edit? %>
                    <%= link_to "edit", edit_admin_user_path(user), class: "btn btn-sm btn-outline-primary" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
