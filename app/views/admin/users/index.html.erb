<% content_for :title, "Пользователи" %>

<div class="container py-4" style="margin-top: 4rem;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Пользователи</h1>
    <%= link_to "Новый пользователь", new_admin_user_path, class: "btn btn-primary" %>
  </div>

  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col">Имя</th>
            <th scope="col">Роль</th>
            <th scope="col">Цвет</th>
            <th scope="col">Основной выбор</th>
            <th scope="col">К сквадам</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <% main_squad = user.squads.find(&:main?) %>
            <tr>
              <td><%= user.name %></td>
              <td><span class="badge text-bg-secondary"><%= user.role %></span></td>
              <td>
                <% if user.color.present? %>
                  <span class="d-inline-flex align-items-center gap-2">
                    <span class="d-inline-block rounded border"
                          style="width: 1.25rem; height: 1.25rem; background-color: <%= user.color %>;"></span>
                    <code><%= user.color %></code>
                  </span>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td>
                <% if main_squad && main_squad.nations.any? %>
                  <div class="d-flex flex-wrap gap-1">
                    <% main_squad.nations.each do |nation| %>
                      <span class="badge text-bg-light border">
                        <%= nation.flag_emoji %> <%= nation.name %>
                      </span>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td>
                <%= link_to "go", admin_user_squads_path(user), class: "btn btn-sm btn-success" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
