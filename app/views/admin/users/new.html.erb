<% content_for :title, "Новый пользователь" %>

<div class="container py-4" style="margin-top: 4rem;">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-header bg-body-tertiary">
          <h1 class="h4 mb-0">Новый пользователь</h1>
        </div>

        <div class="card-body">
          <%= form_with model: [:admin, @user] do |f| %>
            <% if @user.errors.any? %>
              <div class="alert alert-danger" role="alert">
                <h2 class="h6 alert-heading">
                  <%= pluralize(@user.errors.count, "ошибка", "ошибки", "ошибок") %> при сохранении:
                </h2>
                <ul class="mb-0">
                  <% @user.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= f.label :name, "Имя", class: "form-label" %>
              <%= f.text_field :name, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :secret, "Секрет (ссылка для входа)", class: "form-label" %>
              <%= f.text_field :secret, class: "form-control" %>
              <div class="form-text">Используется для входа по ссылке-секрету.</div>
            </div>

            <div class="mb-3">
              <%= f.label :role, "Роль", class: "form-label" %>
              <%= f.select :role, User.roles.keys.map { |r| [r, r] }, {}, class: "form-select" %>
            </div>

            <div class="mb-3">
              <%= f.label :color, "Цвет", class: "form-label" %>
              <%= f.color_field :color, class: "form-control form-control-color" %>
            </div>

            <div class="d-flex gap-2">
              <%= f.submit "Создать", class: "btn btn-primary" %>
              <%= link_to "Отмена", root_path, class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
