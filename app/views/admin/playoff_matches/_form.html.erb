<%= form_with model: @match, url: admin_playoff_matches_path, scope: :match,
      data: {
        controller: "playoff-builder",
        playoff_builder_options_url_value: options_admin_playoff_matches_path
      } do |f| %>
  <% if @match.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <h2 class="h6 alert-heading">
        <%= pluralize(@match.errors.count, "ошибка", "ошибки", "ошибок") %> при сохранении:
      </h2>
      <ul class="mb-0">
        <% @match.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-12 col-md-6">
      <%= f.label :stage, "Стадия", class: "form-label" %>
      <%= f.select :stage, Match.stages.keys.map { |s| [s.humanize, s] }, {},
            class: "form-select",
            data: {
              playoff_builder_target: "stage",
              action: "change->playoff-builder#reload"
            } %>
    </div>
  </div>

  <div id="playoff_match_fields" data-playoff-builder-target="fields" class="mt-3">
    <%= render "fields", stage: @match.stage %>
  </div>

  <div class="d-flex gap-2 mt-4">
    <%= f.submit "Собрать матч", class: "btn btn-primary" %>
    <%= link_to "Отмена", admin_matches_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
