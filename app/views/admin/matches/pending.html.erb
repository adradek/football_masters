<% content_for :title, "Матчи, ждущие обработки" %>

<div class="container py-4" style="margin-top: 4rem;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 class="h4 mb-0">Ждут обработки</h1>
      <p class="text-muted small mb-0">Начались более 2 часов назад и ещё не доведены до completed.</p>
    </div>
    <%= link_to "Все матчи", admin_matches_path, class: "btn btn-outline-secondary" %>
  </div>

  <%= render "matches_table", matches: @matches, empty_message: "Нет матчей, ждущих обработки." %>
</div>
